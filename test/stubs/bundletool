#!/usr/bin/env bash
# Stub bundletool. Only `dump config` is implemented; STUB_BUNDLETOOL_ALIGNED
# decides whether the printed config declares PAGE_ALIGNMENT_16K.
set -eu
if [[ "${STUB_BUNDLETOOL_FAIL:-0}" == "1" ]]; then
  echo "stub bundletool: forced failure" >&2
  exit 1
fi
# Real bundletool chatters on stderr under recent JDKs; mimic that so the
# tool's stderr suppression stays exercised.
echo "WARNING: sun.misc.Unsafe::objectFieldOffset is deprecated" >&2
echo "optimizations {"
echo "  uncompressNativeLibraries {"
echo "    enabled: true"
if [[ "${STUB_BUNDLETOOL_ALIGNED:-1}" == "1" ]]; then
  echo "    alignment: PAGE_ALIGNMENT_16K"
fi
echo "  }"
echo "}"
